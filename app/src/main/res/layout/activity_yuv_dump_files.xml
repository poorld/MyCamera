<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/yuv_dump_files_title"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/yuv_dump_files_directory"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/yuvDumpRefreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/yuv_dump_button_background"
            android:text="@string/yuv_dump_refresh_files"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/yuvDumpFileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/yuv_dump_files_loading"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/yuvDumpFileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical" />

        <ImageView
            android:id="@+id/yuvDumpPreview"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginBottom="12dp"
            android:adjustViewBounds="true"
            android:background="@color/black"
            android:contentDescription="@string/yuv_dump_preview"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/yuvDumpFileDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
