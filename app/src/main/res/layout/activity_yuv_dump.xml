<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/yuv_dump_test"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/yuvDumpEnableSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/yuv_dump_enable"
            android:textColor="@color/white"
            android:thumb="@drawable/settings_switch_thumb"
            android:track="@drawable/settings_switch_track" />

        <Switch
            android:id="@+id/yuvDumpRrzoSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/yuv_dump_rrzo"
            android:textColor="@color/white"
            android:thumb="@drawable/settings_switch_thumb"
            android:track="@drawable/settings_switch_track" />

        <Switch
            android:id="@+id/yuvDumpDisplaySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/yuv_dump_display"
            android:textColor="@color/white"
            android:thumb="@drawable/settings_switch_thumb"
            android:track="@drawable/settings_switch_track" />

        <Switch
            android:id="@+id/yuvDumpRecordSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/yuv_dump_record"
            android:textColor="@color/white"
            android:thumb="@drawable/settings_switch_thumb"
            android:track="@drawable/settings_switch_track" />

        <Button
            android:id="@+id/yuvDumpOverlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/yuv_dump_button_background"
            android:text="@string/yuv_dump_overlay_start"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/yuvDumpCaptureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/yuv_dump_button_background"
            android:text="@string/yuv_dump_capture"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/yuv_dump_device_files"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/yuvDumpRefreshButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/yuv_dump_button_background"
                android:text="@string/yuv_dump_refresh_files"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/yuvDumpDecodeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/yuv_dump_button_background"
                android:enabled="false"
                android:text="@string/yuv_dump_decode"
                android:textColor="@color/white" />
        </LinearLayout>

        <Spinner
            android:id="@+id/yuvDumpFileSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/yuvDumpFileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/yuv_dump_files_loading"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/yuvDumpPreview"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginBottom="16dp"
            android:adjustViewBounds="true"
            android:background="@color/black"
            android:contentDescription="@string/yuv_dump_preview"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/yuvDumpStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/yuv_dump_hint"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
