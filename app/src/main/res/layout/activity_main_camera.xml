<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview -->
    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.android.mycamera.focus.GeminiFocusView
        android:id="@+id/focusView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/cameraPreview"
        app:layout_constraintBottom_toBottomOf="@id/cameraPreview"
        app:layout_constraintStart_toStartOf="@id/cameraPreview"
        app:layout_constraintEnd_toEndOf="@id/cameraPreview" />

    <!-- Top Control Bar -->
    <LinearLayout
        android:id="@+id/topControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/top_control_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:tint="@color/white" />

        <ImageButton
            android:id="@+id/focusAfButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="4dp"
            android:src="@drawable/ic_focus_af"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="AF / OIS"
            android:tint="@color/white" />

        <ImageButton
            android:id="@+id/apiSwitcherButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_layers"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Switch API"
            android:tint="@color/white"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/exposureButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ic_manual_exposure"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Manual exposure"
            android:visibility="gone" />



        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/switchCameraButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_camera_switch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Switch Camera"
            android:tint="@color/white" />

        <ImageButton
            android:id="@+id/flashButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_flash_off"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Flash"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/galleryButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_gallery"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Gallery"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/denoiseButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="5dp"
                android:src="@drawable/ic_denoise"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/microphone_denoise"
                android:tint="@color/white" />
        </LinearLayout>
        
        
    </LinearLayout>

    <!-- Bottom Control Panel -->
    <com.android.mycamera.ui.view.ZoomDialView
        android:id="@+id/zoomDial"
        android:layout_width="220dp"
        android:layout_height="118dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/zoomQuickBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/zoomQuickBar"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        android:background="@drawable/status_background"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/zoomMinText"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/zoomCurrentText"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFD400"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/zoomThirdText"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/zoomMaxText"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bottom_control_background"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Camera Settings Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/settings_resolution_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:text="1080p" />

            <TextView
                android:id="@+id/settings_framerate_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:layout_marginStart="8dp"
                android:text="30 FPS" />
        </LinearLayout>

        <!-- Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/recordingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Capture Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/photoModeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_photo_camera"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Photo Mode" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/captureButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/capture_button_background"
                android:contentDescription="Capture" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/videoModeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_video_camera"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Video Mode" />
        </LinearLayout>
    </LinearLayout>

    <!-- Loading Overlay -->
    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- API Switcher Panel -->
    <LinearLayout
        android:id="@+id/exposureControlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:background="@drawable/api_switcher_background"
        app:layout_constraintTop_toBottomOf="@id/topControls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_manual_exposure"
                android:contentDescription="" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="曝光控制"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/exposureAutoButton"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="AUTO"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sceneSnapshotButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="抓拍"
                android:textSize="12sp" />

            <Button
                android:id="@+id/sceneHandheldNightButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="夜景"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sceneTripodLongExposureButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="曝光"
                android:textSize="12sp" />

            <Button
                android:id="@+id/sceneSunnyOutdoorButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="户外"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="ISO"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/isoSeekBar"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/isoValueText"
                android:layout_width="74dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="Shutter"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/shutterSeekBar"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/shutterValueText"
                android:layout_width="74dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/apiSwitcherPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/api_switcher_background"
        app:layout_constraintTop_toBottomOf="@id/topControls">


        <RadioGroup
            android:id="@+id/apiRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <RadioButton
                android:id="@+id/apiCameraX"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CameraX"
                android:textColor="@color/white"/>

            <RadioButton
                android:id="@+id/apiCamera2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera2"
                android:textColor="@color/white"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/apiCamera1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera1"
                android:textColor="@color/white"/>
        </RadioGroup>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
